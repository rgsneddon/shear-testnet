   return due;
 }
 
+/** Matured principal that is already a time-locked note.
+ *  The note is that principal. Paying it from withdraw spends it twice. */
+function maturedNotePrincipal(state, portal, nowMs) {
+  const tranches = portal?.tranches;
+  if (!Array.isArray(tranches) || tranches.length === 0) return 0n;
+  const chain = chainEpochIndex(state, nowMs);
+  let due = 0n;
+  for (const tranche of tranches) {
+    if (!tranche?.noteIsPrincipal) continue;
+    if (chain > Math.floor(Number(tranche.epoch) || 0)) due += asBig(tranche.amount);
+  }
+  return due;
+}
