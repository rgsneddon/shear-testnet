{
  "name": "shear",
  "version": "0.1",
  "private": true,
  "type": "module",
  "description": "Shear — continuity-settled proof of work",
  "scripts": {
    "build:admit": "make -C crypto/native shearadmit.node",
    "test": "npm run build:admit && node --test --test-concurrency=1 --test-timeout=1800000 crypto/*.test.js crypto/admit.bench.js node/tests/*.js pool/tests/*.js miner/tests/*.js sheark-miner/tests/*.js tests/*.js tests/adversary/*.js",
    "node": "node node/src/node.js",
    "solo": "node node/src/node.js --solo",
    "pool": "node pool/src/main.js",
    "forbid": "node tests/forbid_foreign_names.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/mpt": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0",
    "solc": "^0.8.36"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
