pkgname=shear-wallet
pkgver=0.0.8
pkgrel=1
pkgdesc='Shear wallet'
url='https://github.com/rgsneddon/shear'
arch=('x86_64')
license=('MIT')
depends=('gtk3')
source=("https://github.com/rgsneddon/shear/releases/download/v${pkgver}/shear-wallet-${pkgver}-linux.zip")
sha256sums=('SKIP')

package() {
  install -d "${pkgdir}/opt/shear-wallet" "${pkgdir}/usr/bin"
  cp -a "${srcdir}/." "${pkgdir}/opt/shear-wallet/"
  printf '%s\n' '#!/bin/sh' 'exec /opt/shear-wallet/shear_wallet "$@"' \
    > "${pkgdir}/usr/bin/shear-wallet"
  chmod 755 "${pkgdir}/usr/bin/shear-wallet"
}
