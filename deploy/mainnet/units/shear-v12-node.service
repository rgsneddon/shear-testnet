# Shear v12 public testnet node: p2p-a (Debian) and p2p-b (Fedora). Owns
# :30303 while the v12 testnet is the public net, before mainnet genesis.
# R18a, deploy/mainnet/RUNBOOK.md. Installed only on Russell's GO.
#
# The same hardening and rules as shear-node.service (no silent recovery, no
# phone-home, no copies), on the v12 book (SHEAR_NETWORK=shear-testnet-v12),
# its own datadir, seal keys and release tree (/opt/shear-v12). It shares
# :30303 and the RPC port with the mainnet unit, so only one of the two runs:
# this one before genesis, shear-node.service after (RUNBOOK step 8). The
# v12 teardown removes this unit and its state and never touches mainnet.
[Unit]
Description=Shear v12 testnet node (p2p, owns :30303)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shear
Group=shear
WorkingDirectory=/opt/shear-v12
# StateDirectory creates these under /var/lib, owned by the shear user, and
# makes them the only writable paths.
StateDirectory=shear/testnet-v12 shear/seal-keys-v12/node
StateDirectoryMode=0700
Environment=SHEAR_DATA=/var/lib/shear/testnet-v12
Environment=SHEAR_SEAL_KEY_DIR=/var/lib/shear/seal-keys-v12/node
Environment=SHEAR_NETWORK=shear-testnet-v12
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
Environment=SHEAR_RPC_PORT=18332
Environment=SHEAR_RPC_BIND=127.0.0.1
# Seeds are DNS names only, never a host IP.
Environment=SHEAR_SEEDS=p2p.shear.digital:30303,r2r.shear.digital:30303
Environment=SHEAR_REORG_HALT_DEPTH=0
ExecStart=/usr/bin/node node/src/node.js --mode=p2p-sync
Restart=no
# Hardening. The datadir and seal keys are 0700 for the shear user only.
# No MemoryDenyWriteExecute: node's V8 JIT needs writable executable pages.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
