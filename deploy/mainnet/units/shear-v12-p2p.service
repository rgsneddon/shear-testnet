# Shear v12 public testnet P2P sidecar on the pool host (Ubuntu). Owns
# :30303 and feeds the v12 pool on 127.0.0.1:30313, before mainnet genesis.
# R18a, deploy/mainnet/RUNBOOK.md. Installed only on Russell's GO.
#
# Mirrors shear-p2p.service on the v12 book, with its own datadir, seal keys
# and release tree (/opt/shear-v12). It shares its ports with the mainnet
# unit, so only one of the two runs (RUNBOOK step 8).
[Unit]
Description=Shear v12 testnet P2P sidecar for the pool host (owns :30303)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shear
Group=shear
WorkingDirectory=/opt/shear-v12
# Its own datadir and seal keys: the pool and this node share no chain files.
StateDirectory=shear/testnet-v12-p2p shear/seal-keys-v12/p2p
StateDirectoryMode=0700
Environment=SHEAR_DATA=/var/lib/shear/testnet-v12-p2p
Environment=SHEAR_SEAL_KEY_DIR=/var/lib/shear/seal-keys-v12/p2p
Environment=SHEAR_NETWORK=shear-testnet-v12
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
Environment=SHEAR_P2P_IPC=127.0.0.1:30313
Environment=SHEAR_RPC_PORT=18333
Environment=SHEAR_RPC_BIND=127.0.0.1
Environment=SHEAR_SEEDS=p2p.shear.digital:30303,r2r.shear.digital:30303
Environment=SHEAR_REORG_HALT_DEPTH=0
ExecStart=/usr/bin/node node/src/node.js --mode=p2p-sync
Restart=no
# Hardening. The datadir and seal keys are 0700 for the shear user only.
# No MemoryDenyWriteExecute: node's V8 JIT needs writable executable pages.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
