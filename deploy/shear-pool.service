[Unit]
Description=Shear testnet-v4 pool (ADMITv2, stratum 1111)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/shear-v4
# Pool owns stratum :1111 and HTTP loopback :8088. It does not bind :30303.
# shear-p2p.service owns P2P and feeds verified blocks on 127.0.0.1:30313.
Environment=SHEAR_DATA=/var/lib/shear/testnet-v4
Environment=SHEAR_NETWORK=shear-testnet-v4
Environment=SHEAR_P2P_IPC=127.0.0.1:30313
Environment=SHEAR_STRATUM=1111
# Prod example: bind loopback and terminate TLS on nginx/Caddy. Testnet may set 0.0.0.0.
Environment=SHEAR_STRATUM_BIND=127.0.0.1
Environment=SHEAR_STRATUM_AUTH=1
Environment=SHEAR_HTTP=8088
Environment=SHEAR_SHARE_BITS=8
Environment=SHEAR_RPC_BIND=127.0.0.1
Environment=SHEAR_ADMIN_HOST=mypool.site
# In-process payout sweep: every 4s, one π SHE lot once a miner has accrued π.
Environment=SHEAR_PAYOUT_SWEEP_MS=4000
ExecStart=/usr/bin/node pool/src/main.js
Restart=always
RestartSec=2
MemoryAccounting=yes
MemoryHigh=1024M
MemoryMax=1536M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
