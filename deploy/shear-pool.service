[Unit]
Description=Shear testnet pool (stratum 1111)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/shear-v2
Environment=SHEAR_DATA=/var/lib/shear/testnet-v2
Environment=SHEAR_STRATUM=1111
Environment=SHEAR_HTTP=8088
Environment=SHEAR_SHARE_BITS=8
Environment=SHEAR_BITS=21
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
ExecStart=/usr/local/bin/node pool/src/main.js
Restart=always
RestartSec=2
MemoryAccounting=yes
MemoryHigh=1024M
MemoryMax=1536M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
