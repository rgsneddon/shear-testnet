[Unit]
Description=Shear testnet-v4 pool (ADMITv2, stratum 1111)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/shear-v4
Environment=SHEAR_DATA=/var/lib/shear/testnet-v4-pool
Environment=SHEAR_NETWORK=shear-testnet-v4
Environment=SHEAR_SEEDS=p2p.shear.digital:30303
Environment=SHEAR_STRATUM=1111
Environment=SHEAR_HTTP=8088
Environment=SHEAR_SHARE_BITS=8
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
ExecStart=/usr/bin/node pool/src/main.js
Restart=always
RestartSec=2
MemoryAccounting=yes
MemoryHigh=1024M
MemoryMax=1536M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
