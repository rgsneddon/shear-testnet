[Unit]
Description=Shear testnet-v4 P2P sidecar for the pool host (owns :30303)
After=network.target shear-pool.service
Wants=shear-pool.service

[Service]
Type=simple
WorkingDirectory=/opt/shear-v4
# Separate datadir from the pool so two processes do not share the chain files.
# Verified blocks cross 127.0.0.1:30313. This process binds :30303.
Environment=SHEAR_DATA=/var/lib/shear/testnet-v4-p2p
Environment=SHEAR_NETWORK=shear-testnet-v4
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
Environment=SHEAR_P2P_IPC=127.0.0.1:30313
Environment=SHEAR_RPC_PORT=18333
Environment=SHEAR_RPC_BIND=127.0.0.1
# Public seeds are hostnames only. Never raw fleet IPs in this unit.
Environment=SHEAR_SEEDS=p2p.shear.digital:30303,r2r.shear.digital:30303,b2b.shear.digital:30303
Environment=SHEAR_REORG_HALT_DEPTH=0
ExecStart=/usr/bin/node node/src/node.js --mode=p2p-sync
Restart=always
RestartSec=2
MemoryAccounting=yes
MemoryHigh=1024M
MemoryMax=1536M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
