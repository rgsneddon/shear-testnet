[Unit]
Description=Shear Sentinel v19 P2P node (shear-testnet-v12)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/shear-v12
Environment=SHEAR_DATA=/var/lib/shear/testnet-v12
Environment=SHEAR_NETWORK=shear-testnet-v12
Environment=SHEAR_P2P_PORT=30303
Environment=SHEAR_P2P_BIND=0.0.0.0
Environment=SHEAR_RPC_PORT=18332
Environment=SHEAR_RPC_BIND=127.0.0.1
# Hostnames only. Do not put fleet addresses in this unit.
Environment=SHEAR_SEEDS=p2p.shear.digital:30303,r2r.shear.digital:30303,b2b.shear.digital:30303
Environment=SHEAR_REORG_HALT_DEPTH=0
ExecStart=/opt/shear-v12/bin/node /opt/shear-v12/node/src/node.js --mode=p2p-sync
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
