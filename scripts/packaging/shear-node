#!/bin/sh
# Shear Sentinel launcher. Install prefix is /opt/shear-v12.
set -e
ROOT=/opt/shear-v12
export SHEAR_DATA="${SHEAR_DATA:-/var/lib/shear/testnet-v12}"
export SHEAR_NETWORK="${SHEAR_NETWORK:-shear-testnet-v12}"
export SHEAR_SEEDS="${SHEAR_SEEDS:-p2p.shear.digital:30303,r2r.shear.digital:30303,b2b.shear.digital:30303}"
export SHEAR_RPC_BIND="${SHEAR_RPC_BIND:-127.0.0.1}"
cd "$ROOT"
exec "$ROOT/bin/node" "$ROOT/node/src/node.js" "$@"
